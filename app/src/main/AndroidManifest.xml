<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos simplificados -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" 
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.INTERNET" />
    
    <application
        android:name=".RWMApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RWM"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="31">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".editor.EditorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RWM.Editor"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        
        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.RWM"
            android:screenOrientation="portrait" />
        
        <!-- Widget Configuration Activity -->
        <activity
            android:name=".widgets.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.RWM.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        
        <!-- Widget Providers para diferentes tamaños -->
        <receiver
            android:name=".widgets.RWMWidgetProvider1x1"
            android:exported="true"
            android:label="RWM Widget 1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rwm_widget_1x1" />
        </receiver>
        
        <receiver
            android:name=".widgets.RWMWidgetProvider2x1"
            android:exported="true"
            android:label="RWM Widget 2x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rwm_widget_2x1" />
        </receiver>
        
        <receiver
            android:name=".widgets.RWMWidgetProvider2x2"
            android:exported="true"
            android:label="RWM Widget 2x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rwm_widget_2x2" />
        </receiver>
        
        <receiver
            android:name=".widgets.RWMWidgetProvider3x3"
            android:exported="true"
            android:label="RWM Widget 3x3">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rwm_widget_3x3" />
        </receiver>
        
        <receiver
            android:name=".widgets.RWMWidgetProvider4x1"
            android:exported="true"
            android:label="RWM Widget 4x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rwm_widget_4x1" />
        </receiver>
        
        <receiver
            android:name=".widgets.RWMWidgetProvider4x2"
            android:exported="true"
            android:label="RWM Widget 4x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rwm_widget_4x2" />
        </receiver>

        <!-- File provider básico -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>